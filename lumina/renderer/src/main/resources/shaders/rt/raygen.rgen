#version 460
#extension GL_EXT_ray_tracing : require
#extension GL_EXT_scalar_block_layout : require

layout(binding = 0, set = 0) uniform accelerationStructureEXT topLevelAS;
layout(binding = 1, set = 0, rgba32f) uniform image2D outputImage;
layout(binding = 2, set = 0, rgba32f) uniform image2D normalDepthImage;
layout(binding = 3, set = 0, rg16f) uniform image2D motionVectorImage;

layout(binding = 4, set = 0, scalar) uniform CameraUBO {
    mat4 viewInverse;
    mat4 projInverse;
    mat4 prevViewProj;
    vec3 position;
    float fov;
    uint frameCount;
    uint spp;
    uint maxBounces;
    float time;
} camera;

layout(location = 0) rayPayloadEXT RayPayload {
    vec3 color;
    vec3 normal;
    float depth;
    vec3 worldPos;
    uint seed;
    bool missed;
    vec3 brdfWeight;
    vec3 bounceDir;
} payload;

uint pcgHash(uint v) {
    uint state = v * 747796405u + 2891336453u;
    uint word = ((state >> ((state >> 28u) + 4u)) ^ state) * 277803737u;
    return (word >> 22u) ^ word;
}

float randomFloat(inout uint seed) {
    seed = pcgHash(seed);
    return float(seed) / 4294967295.0;
}

// Interleaved Gradient Noise — blue-noise-like spatial distribution.
// Animated over frames via the golden-ratio shift so error decorrelates temporally.
float ign(ivec2 p, uint frame) {
    float f = float(frame % 64u);
    vec2 fp = vec2(p) + f * vec2(5.588238, 5.588238);
    return fract(52.9829189 * fract(0.06711056 * fp.x + 0.00583715 * fp.y));
}

void main() {
    ivec2 pixelCoord = ivec2(gl_LaunchIDEXT.xy);
    ivec2 launchSize = ivec2(gl_LaunchSizeEXT.xy);

    float ignVal = ign(pixelCoord, camera.frameCount);
    uint seed = pcgHash(uint(ignVal * 16777216.0) ^ (uint(pixelCoord.x) * 1973u + uint(pixelCoord.y) * 9277u + camera.frameCount * 26699u));

    vec3 accumulatedColor = vec3(0.0);
    vec3 firstNormal = vec3(0.0);
    float firstDepth = 0.0;
    vec3 motionWorldPos = vec3(0.0);

    for (uint s = 0; s < camera.spp; s++) {
        float jitterX;
        float jitterY;
        if (s == 0u) {
            jitterX = fract(ignVal + 0.61803398875) - 0.5;
            jitterY = fract(ignVal * 1.32471795724 + 0.7548776662) - 0.5;
        } else {
            jitterX = randomFloat(seed) - 0.5;
            jitterY = randomFloat(seed) - 0.5;
        }

        vec2 uv = (vec2(pixelCoord) + vec2(0.5) + vec2(jitterX, jitterY)) / vec2(launchSize);
        vec2 ndc = uv * 2.0 - 1.0;
        ndc.y = -ndc.y;

        vec4 origin = camera.viewInverse * vec4(0, 0, 0, 1);
        vec4 target = camera.projInverse * vec4(ndc.x, ndc.y, 1, 1);
        target.xyz /= target.w;
        vec4 direction = camera.viewInverse * vec4(normalize(target.xyz), 0);

        vec3 throughput = vec3(1.0);
        vec3 radiance = vec3(0.0);
        vec3 rayOrigin = origin.xyz;
        vec3 rayDir = direction.xyz;

        uint maxSegments = min(min(camera.maxBounces, 8u) + 1u, 9u);
        for (uint bounce = 0; bounce < maxSegments; bounce++) {
            payload.color = vec3(0.0);
            payload.seed = seed;
            payload.missed = false;

            traceRayEXT(topLevelAS,
                gl_RayFlagsOpaqueEXT,
                0xFF,
                0, 0, 0,
                rayOrigin,
                0.001,
                rayDir,
                10000.0,
                0);

            radiance += min(throughput * payload.color, vec3(10.0));
            if (payload.missed) {
                break;
            }

            if (bounce == 0u) {
                motionWorldPos = payload.worldPos;
                if (s == 0u) {
                    firstNormal = payload.normal;
                    firstDepth = payload.depth;
                }
            }

            throughput *= payload.brdfWeight;

            if (bounce >= 1u) {
                float p = max(throughput.r, max(throughput.g, throughput.b));
                if (p < 0.05 || randomFloat(seed) >= p) {
                    break;
                }
                throughput /= p;
            }

            rayOrigin = payload.worldPos + payload.normal * 0.002;
            rayDir = payload.bounceDir;
            seed = payload.seed;
        }

        accumulatedColor += radiance;
        seed = payload.seed;
    }

    accumulatedColor /= max(float(camera.spp), 1.0);

    imageStore(outputImage, pixelCoord, vec4(accumulatedColor, 1.0));
    imageStore(normalDepthImage, pixelCoord, vec4(firstNormal, firstDepth));

    // Motion vectors for temporal reprojection
    vec4 clipPos = camera.prevViewProj * vec4(motionWorldPos, 1.0);
    vec2 prevUV = (clipPos.xy / clipPos.w) * 0.5 + 0.5;
    vec2 currentUV = vec2(pixelCoord) / vec2(launchSize);
    vec2 motion = currentUV - prevUV;
    imageStore(motionVectorImage, pixelCoord, vec4(motion, 0.0, 0.0));
}
