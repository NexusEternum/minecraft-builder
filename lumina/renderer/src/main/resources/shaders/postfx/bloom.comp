#version 460

layout(local_size_x = 16, local_size_y = 16) in;

layout(binding = 0, rgba32f) uniform image2D inputImage;
layout(binding = 1, rgba32f) uniform image2D outputImage;

layout(push_constant) uniform Params {
    int mode;       // 0=threshold, 1=downsample, 2=upsample
    float threshold;
    float intensity;
    int level;
};

// Dual Kawase downsample
vec3 kawaseDown(ivec2 coord, ivec2 size) {
    vec2 texelSize = 1.0 / vec2(size);
    vec2 uv = (vec2(coord) + 0.5) / vec2(size);

    vec3 sum = imageLoad(inputImage, coord).rgb * 4.0;
    sum += imageLoad(inputImage, clamp(coord + ivec2(-1, -1), ivec2(0), size-1)).rgb;
    sum += imageLoad(inputImage, clamp(coord + ivec2( 1, -1), ivec2(0), size-1)).rgb;
    sum += imageLoad(inputImage, clamp(coord + ivec2(-1,  1), ivec2(0), size-1)).rgb;
    sum += imageLoad(inputImage, clamp(coord + ivec2( 1,  1), ivec2(0), size-1)).rgb;
    return sum / 8.0;
}

// Dual Kawase upsample
vec3 kawaseUp(ivec2 coord, ivec2 size) {
    vec3 sum = vec3(0.0);
    sum += imageLoad(inputImage, clamp(coord + ivec2(-1, 0), ivec2(0), size-1)).rgb * 2.0;
    sum += imageLoad(inputImage, clamp(coord + ivec2( 1, 0), ivec2(0), size-1)).rgb * 2.0;
    sum += imageLoad(inputImage, clamp(coord + ivec2(0, -1), ivec2(0), size-1)).rgb * 2.0;
    sum += imageLoad(inputImage, clamp(coord + ivec2(0,  1), ivec2(0), size-1)).rgb * 2.0;
    sum += imageLoad(inputImage, clamp(coord + ivec2(-1, -1), ivec2(0), size-1)).rgb;
    sum += imageLoad(inputImage, clamp(coord + ivec2( 1, -1), ivec2(0), size-1)).rgb;
    sum += imageLoad(inputImage, clamp(coord + ivec2(-1,  1), ivec2(0), size-1)).rgb;
    sum += imageLoad(inputImage, clamp(coord + ivec2( 1,  1), ivec2(0), size-1)).rgb;
    return sum / 12.0;
}

void main() {
    ivec2 coord = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(inputImage);
    if (coord.x >= size.x || coord.y >= size.y) return;

    vec3 result;
    if (mode == 0) {
        vec3 color = imageLoad(inputImage, coord).rgb;
        float brightness = max(max(color.r, color.g), color.b);
        result = color * max(brightness - threshold, 0.0) / max(brightness, 0.001);
    } else if (mode == 1) {
        result = kawaseDown(coord, size);
    } else {
        result = kawaseUp(coord, size) * intensity;
    }

    imageStore(outputImage, coord, vec4(result, 1.0));
}
